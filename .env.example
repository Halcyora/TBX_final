# ============================================================================
# AWS Bedrock Configuration
# ============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# ============================================================================
# AWS Bedrock Model IDs (Amazon Nova Micro as default)
# Nova Micro: 1.3B parameters, PS Section 7 compliant (<=20B params)
# ============================================================================
NOVA_MICRO_MODEL_ID=amazon.nova-micro-v1:0

# Optional: Alternative models for benchmarking (all <=20B params)
LLAMA_8B_MODEL_ID=meta.llama3-1-8b-instruct-v1:0
MISTRAL_7B_MODEL_ID=mistral.mistral-7b-instruct-v0:2
LLAMA_SCOUT_17B_MODEL_ID=meta.llama4-scout-17b-instruct-v1:0

# Default model for API (PS-compliant)
DEFAULT_MODEL=amazon.nova-micro

# ============================================================================
# Redis Configuration (for session + prompt caching)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# DuckDB Configuration
# ============================================================================
DUCKDB_PATH=./data/finance.db
DUCKDB_MEMORY_LIMIT=4GB

# ============================================================================
# LangGraph & LLM Configuration
# ============================================================================
LLM_TEMPERATURE_BASE=0.7
LLM_MAX_TOKENS=2048
CONFIDENCE_THRESHOLD=0.60

# Anomaly Detection
ANOMALY_ZSCORE_THRESHOLD=2.0
ANOMALY_MULTIPLIER_THRESHOLD=3.0

# Context Window Strategy
MAX_CONTEXT_TURNS=3
INCLUDE_TURN_SUMMARIES=true

# ============================================================================
# FastAPI Configuration
# ============================================================================
FASTAPI_HOST=localhost
FASTAPI_PORT=8000
DEBUG_MODE=true

# ============================================================================
# Session Configuration
# ============================================================================
SESSION_TIMEOUT_MINUTES=60
MAX_SESSIONS=100
SESSION_STORE=redis  # Options: redis, memory

# ============================================================================
# Export Configuration
# ============================================================================
MAX_EXPORT_ROWS=50000
EXPORT_FORMATS=csv  # Options: csv, excel, json

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/finance_assistant.log
