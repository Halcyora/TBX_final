# ============================================================================
# Self-hosted vLLM Endpoint (preferred LLM when reachable - PS-compliant, 1.5B params)
# ============================================================================
VLLM_ENDPOINT_URL=https://your-vllm-endpoint.example.com/v1/chat/completions
VLLM_MODEL_ID=Qwen/Qwen2.5-Coder-1.5B-Instruct

# ============================================================================
# AWS Bedrock Configuration (fallback when vLLM is unavailable)
# ============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# ============================================================================
# MySQL Configuration (OPTIONAL - for verification against a live database)
# If MYSQL_HOST, MYSQL_USER and MYSQL_DATABASE are all set, the backend attaches
# this MySQL instance via DuckDB's mysql extension. Leave blank to use local CSV data.
# ============================================================================
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ============================================================================
# Account Number Encryption
# Account numbers are encrypted in the database and can only be revealed with a valid decryption code.
# This ensures sensitive account data is protected from unauthorized access.
#
# To generate a new encryption key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ENCRYPTION_KEY: The master key used to encrypt/decrypt account numbers
# DECRYPTION_CODES: Comma-separated list of codes that can decrypt account numbers
#                   The judge/evaluator should provide their own decryption code
# ============================================================================
ENCRYPTION_KEY=
DECRYPTION_CODES=code1,code2,judge_code

# ============================================================================
# FastAPI Configuration
# ============================================================================
FASTAPI_HOST=localhost
FASTAPI_PORT=8000
DEBUG_MODE=true

# ============================================================================
# Session Configuration
# ============================================================================
SESSION_TIMEOUT_MINUTES=60
CONFIDENCE_THRESHOLD=0.60
SESSION_STORE_PATH=./data/sessions_store.json

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# Frontend Configuration
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
