# ============================================================================
# Primary LLM: Qwen2.5-Coder-1.5B-Instruct
# Served locally now (e.g. Ollama: `ollama pull qwen2.5-coder:1.5b-instruct`, which exposes
# an OpenAI-compatible API at LLM_BASE_URL), and later via vLLM on GCP - same client code,
# just point LLM_BASE_URL at the deployed endpoint.
# ============================================================================
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5-coder:1.5b-instruct
DEFAULT_MODEL=qwen2.5-coder-1.5b

# ============================================================================
# Fallback: AWS Bedrock (switchable via the `model` field on /chat, e.g. "amazon.nova-micro")
# ============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

NOVA_MICRO_MODEL_ID=amazon.nova-micro-v1:0
LLAMA_8B_MODEL_ID=meta.llama3-1-8b-instruct-v1:0
MISTRAL_7B_MODEL_ID=mistral.mistral-7b-instruct-v0:2
LLAMA_SCOUT_17B_MODEL_ID=meta.llama4-scout-17b-instruct-v1:0

# ============================================================================
# Redis Configuration (verified-query cache - optional, skipped silently if unreachable)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============================================================================
# DuckDB Configuration
# ============================================================================
DUCKDB_PATH=./data/finance.db
DUCKDB_MEMORY_LIMIT=4GB

# Hard wall-clock cap on any single query (seconds) - cancelled via conn.interrupt() if exceeded.
# Found necessary after a self-join with an OR join condition took 938s/~15GB on 500K rows.
QUERY_TIMEOUT_SECONDS=15

# ============================================================================
# LangGraph & LLM Configuration
# ============================================================================
LLM_TEMPERATURE_BASE=0.7
LLM_MAX_TOKENS=2048
CONFIDENCE_THRESHOLD=0.60

# Execution-guided self-consistency: sample this many SQL candidates concurrently and
# majority-vote on the executed result (see INTERNAL_NOTES.md §3.5). Set to 1 to disable
# (single low-temperature shot, the original behavior).
SQL_SELF_CONSISTENCY_N=3

# Anomaly Detection
ANOMALY_ZSCORE_THRESHOLD=2.0
ANOMALY_MULTIPLIER_THRESHOLD=3.0

# Context Window Strategy
MAX_CONTEXT_TURNS=3
INCLUDE_TURN_SUMMARIES=true

# ============================================================================
# FastAPI Configuration
# ============================================================================
FASTAPI_HOST=localhost
FASTAPI_PORT=8000
DEBUG_MODE=true

# ============================================================================
# Session Configuration
# ============================================================================
SESSION_TIMEOUT_MINUTES=60
MAX_SESSIONS=100
SESSION_STORE=redis  # Options: redis, memory

# ============================================================================
# Export Configuration
# ============================================================================
MAX_EXPORT_ROWS=50000
EXPORT_FORMATS=csv  # Options: csv, excel, json

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/finance_assistant.log
